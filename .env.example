# Copy this file to .env.local and fill it in.  (cp .env.example .env.local)

# A long random string used to sign login sessions. REQUIRED in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# The first admin account, created automatically the first time the app runs
# (only if data/db.json doesn't exist yet). Change the password after first login.
ADMIN_EMAIL=admin@aurum.local
ADMIN_PASSWORD=aurum-admin-123

# Aurum's WhatsApp number with country code, digits only (e.g. 919876543210).
# Checkout hands the order to this number. Leave empty to send people to Instagram instead.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public URL of the site (used for SEO tags). e.g. https://aurum.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: where the JSON database and uploaded photos live (defaults to ./data)
# DATA_DIR=/var/aurum-data

# Optional: set to false only to test a production build over plain http
# COOKIE_SECURE=false
